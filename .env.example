# Port to run Track Vault on
PORT=3000

# Server Origin (for SvelteKit CSRF protection, e.g. http://localhost:3000 or http://192.168.1.50:3000)
ORIGIN=http://localhost:3000

# SQLite data directory
DATA_DIR=./data

# Path on the host machine to your music library folder (e.g. /mnt/storage/music or ~/Music)
MUSIC_PATH=./music
