# syntax=docker/dockerfile:1
FROM ghcr.io/cirruslabs/android-sdk:34

ENV ANDROID_HOME="/opt/android-sdk-linux"
ENV ANDROID_SDK_ROOT="/opt/android-sdk-linux"

WORKDIR /app

# Pre-cache Gradle wrapper and build configuration
COPY gradle/ gradle/
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY app/build.gradle.kts app/

# Pre-fetch Gradle distribution and dependencies in cached layer
RUN ./gradlew --version && \
    ./gradlew :app:dependencies --configuration releaseCompileClasspath --no-daemon || true

# Copy full application source code
COPY . .

# Compile Signed Release Android APK
RUN ./gradlew assembleRelease --no-daemon --stacktrace
